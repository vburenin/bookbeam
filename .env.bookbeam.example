# Copy to .env.bookbeam and edit.

# Logins: comma/space/semicolon separated user:password pairs.
# To avoid storing plain-text passwords, use user:sha256:<hex>, where <hex> is
# the output of:  printf '%s' 'the-password' | sha256sum
BOOKBEAM_USERS="mom:change-me, dad:sha256:<64-hex-digest-of-dads-password>"

# Set to 1 when served via HTTPS so the session cookie is marked Secure
# (detected automatically when the proxy sends X-Forwarded-Proto: https).
# COOKIE_SECURE=1

# Absolute path to your audiobooks on the host (bind-mounted to /data).
BOOKBEAM_DATA=/abs/path/to/your/audiobooks

# Optional: where BookBeam keeps its state (default: /data/.bookbeam).
# BOOKBEAM_STATE=/config

# Optional: URL prefix if your reverse proxy does NOT strip it (e.g. /books).
# Proxies that strip the prefix should send X-Forwarded-Prefix instead.
# BOOKBEAM_BASE_PATH=/books

# Optional: how often to look for new/changed books (default 30m).
# BOOKBEAM_SCAN_INTERVAL=30m
